APP_NAME=RuangTitip
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Migrasi memakai sintaks MySQL/MariaDB (ALTER TABLE ... MODIFY, information_schema); gunakan mysql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rutip_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Produksi (HTTPS): aktifkan SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com/v1
BITESHIP_IS_PRODUCTION=false
# Wajib: token acak panjang; daftarkan webhook sebagai https://domain/biteship/webhook?token=ISI_TOKEN
BITESHIP_WEBHOOK_TOKEN=
BITESHIP_WAREHOUSE_NAME=
BITESHIP_WAREHOUSE_PHONE=
BITESHIP_WAREHOUSE_ADDRESS=
BITESHIP_WAREHOUSE_POSTAL_CODE=
BITESHIP_WAREHOUSE_AREA_ID=
BITESHIP_WAREHOUSE_LAT=
BITESHIP_WAREHOUSE_LNG=
BITESHIP_REGULAR_COURIERS=jne,jnt,sicepat,anteraja,ninja,idexpress,pos,lion
BITESHIP_INSTANT_COURIERS=gojek,grab,lalamove

TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_IS_PRODUCTION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# Pembayaran QRIS manual (gambar QRIS: public/assets/payment/qris.png)
QRIS_MERCHANT_NAME="RUANGTITIP, LOGISTIK"
