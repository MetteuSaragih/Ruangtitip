<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lapis pengaman: berkas dan folder internal tidak boleh dibuka lewat browser.
    # Berkas tersembunyi (.env, .git, dst.) ditolak, kecuali folder .well-known untuk sertifikat HTTPS.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|tests)(/|$) - [R=404,L,NC]
    RewriteRule ^vendor/(?!blade-lucide-icons/) - [R=404,L,NC]
    RewriteRule ^(composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|CHANGELOG\.md|README\.md|PERUBAHAN-NAV\.txt)$ - [R=404,L,NC]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
